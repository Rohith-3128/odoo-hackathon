# ==============================================================================
# EZbill Environment Configuration (.env.example)
# Team 1: Foundation, Auth & Database Architecture
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME=EZbill
APP_URL=http://localhost:3000

# Security & Authentication
# Generate a strong 32+ character random secret for production JWT signing
JWT_SECRET=ezbill-foundation-super-secret-jwt-key-2026-secure-random
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Configuration (Persistent Local SQLite by default)
# Zero cloud configuration required - runs 100% offline
DATABASE_FILE=./ezbill_database.sqlite
DATABASE_MIGRATIONS_DIR=./migrations

# CORS & Frontend Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional External API Keys (Simulated / Local Fallbacks active by default)
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
